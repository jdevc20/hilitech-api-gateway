# ==============================================================================
# Application Configuration - API Gateway
# ==============================================================================

# General Settings
NODE_ENV=development
PORT=3000

# ==============================================================================
# Service URLs
# ==============================================================================
# Docker:
# AUTH_SERVICE_URL=http://auth-service:3001
# PROFILE_SERVICE_URL=http://profile-service:3002
# PING_SERVICE_URL=http://ping-service:3003
#
# Local Development (example):
# AUTH_SERVICE_URL=http://localhost:3001
# PROFILE_SERVICE_URL=http://localhost:3002
# PING_SERVICE_URL=http://localhost:3003

AUTH_SERVICE_URL=http://<AUTH_SERVICE_HOST>:<AUTH_SERVICE_PORT>
PROFILE_SERVICE_URL=http://<PROFILE_SERVICE_HOST>:<PROFILE_SERVICE_PORT>
PING_SERVICE_URL=http://<PING_SERVICE_HOST>:<PING_SERVICE_PORT>

# ==============================================================================
# CORS Configuration
# ==============================================================================

CORS_ORIGIN=http://<FRONTEND_HOST>:<FRONTEND_PORT>