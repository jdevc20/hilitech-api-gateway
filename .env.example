# ==============================================================================
# Application Configuration - API Gateway
# ==============================================================================

# General Settings
NODE_ENV=development
PORT=3000

# ==============================================================================
# Gateway Database
# ==============================================================================

# Docker:
# DATABASE_URL=postgresql://myuser:mypassword@gateway-db:5432/hilitech_gateway_db
#
# Local Development:
# DATABASE_URL=postgresql://myuser:mypassword@localhost:4000/hilitech_gateway_db

DATABASE_URL=postgresql://<DATABASE_USER>:<DATABASE_PASSWORD>@<DATABASE_HOST>:<DATABASE_PORT>/<DATABASE_NAME>

# Maximum request or response body size stored in the database (bytes)
REQUEST_LOG_MAX_BODY_BYTES=65536

# ==============================================================================
# Service URLs
# ==============================================================================

# Docker:
# AUTH_SERVICE_URL=http://auth-service:3001
# PROFILE_SERVICE_URL=http://profile-service:3002
# PING_SERVICE_URL=http://ping-service:3003
#
# Local Development:
# AUTH_SERVICE_URL=http://localhost:3001
# PROFILE_SERVICE_URL=http://localhost:3002
# PING_SERVICE_URL=http://localhost:3003

AUTH_SERVICE_URL=http://<AUTH_SERVICE_HOST>:<AUTH_SERVICE_PORT>
PROFILE_SERVICE_URL=http://<PROFILE_SERVICE_HOST>:<PROFILE_SERVICE_PORT>
PING_SERVICE_URL=http://<PING_SERVICE_HOST>:<PING_SERVICE_PORT>

# ==============================================================================
# CORS Configuration
# ==============================================================================

# Multiple origins can be provided as a comma-separated list.
CORS_ORIGINS=http://<FRONTEND_HOST>:<FRONTEND_PORT>